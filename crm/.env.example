# Copy to .env and fill in. .env is git-ignored.

# Your mailbox. Gmail needs an app password: https://myaccount.google.com/apppasswords
IMAP_USER=you@yourcompany.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

# Defaults are for Gmail. Outlook/Microsoft 365: outlook.office365.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Other addresses you send from, so they aren't counted as leads (comma separated).
MY_OTHER_EMAILS=

# Domains or addresses you email that aren't outreach (friends, vendors, your accountant).
# Your own work domain is ignored automatically.
IGNORE_DOMAINS=
IGNORE_EMAILS=

# How far back the first sync looks, and how often it checks for new sent mail.
SYNC_SINCE_DAYS=365
SYNC_INTERVAL_MINUTES=5

# Only needed if your Sent folder isn't detected automatically.
SENT_MAILBOX=

# Company logos come from DuckDuckGo's favicon service. Set to off to show letters only.
COMPANY_LOGOS=on

PORT=3000
